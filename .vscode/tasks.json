// ════════════════════════════════════════════════════════════════════════════
//  find_home — VS Code tasks
//
//  Open the find_home folder as the workspace root: every path uses
//  ${workspaceFolder}. Pattern adapted from the telia_env Debug UI v2
//  (sequenced orchestrator + background problemMatchers) and
//  Interactions_analytics (project-local .vscode, in-project venv).
//
//  Orchestration used by launch.json "FH: Full Stack":
//    preLaunchTask "FH: Dev Prereqs"  (dependsOrder: sequence)
//      ├─ "FH: Free Ports"   → scripts/free-ports.sh (8200, 4400)
//      ├─ "FH: Ensure Env"   → scripts/ensure-env.sh (venv, node_modules, env files if missing)
//      ├─ "FH: Infra Up"     → stop existing Compose containers, start with current config, wait
//      ├─ "FH: Migrate DB"   → findhome db migrate
//      └─ "FH: ng serve"     → background task, ready when Angular prints its local URL
//    then the single backend launch starts under debugpy.
//    postDebugTask "FH: Dev Stop" frees app ports and stops all Compose containers.
// ════════════════════════════════════════════════════════════════════════════
{
    "version": "2.0.0",
    "tasks": [
        // ═══ Infrastructure ═════════════════════════════════════════════════
        {
            "label": "FH: Free Ports",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/free-ports.sh",
            "args": ["--force"],
            "presentation": { "reveal": "silent", "panel": "shared", "close": true },
            "problemMatcher": []
        },
        // Creates whatever is missing (backend/.venv, frontend/node_modules, config/*.env,
        // skill links). Fast no-op when everything exists, so F5 works on a fresh checkout.
        {
            "label": "FH: Ensure Env",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/ensure-env.sh",
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "FH: Infra Up",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/infra-up.sh",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "FH: Infra Stop",
            "type": "shell",
            "command": "docker compose stop --timeout 30",
            "options": { "cwd": "${workspaceFolder}" },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },
        {
            "label": "FH: Migrate DB",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/findhome db migrate",
            "options": { "cwd": "${workspaceFolder}/backend" },
            "presentation": { "reveal": "always", "panel": "shared" },
            "problemMatcher": []
        },

        // ═══ Frontend ═══════════════════════════════════════════════════════
        // The readiness matcher releases the backend pre-launch chain once Angular is serving.
        {
            "label": "FH: ng serve",
            "type": "shell",
            "command": "npx ng serve --port 4400 --proxy-config proxy.conf.json",
            "options": {
                "cwd": "${workspaceFolder}/frontend",
                "env": { "NO_COLOR": "1", "NG_CLI_ANALYTICS": "false" }
            },
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated", "group": "fh-ui" },
            "problemMatcher": {
                "base": "$tsc",
                "owner": "fh-ng",
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "Building|Compiling|Initial chunk files",
                    "endsPattern": "Local:.*http://(localhost|127\\.0\\.0\\.1):4400|Application bundle generation failed"
                }
            }
        },
        {
            "label": "FH: Frontend tests",
            "type": "shell",
            "command": "npx ng test --watch=false",
            "options": { "cwd": "${workspaceFolder}/frontend" },
            "problemMatcher": []
        },

        // ═══ Orchestrator ═══════════════════════════════════════════════════
        {
            "label": "FH: Dev Prereqs",
            "dependsOn": ["FH: Free Ports", "FH: Ensure Env", "FH: Infra Up", "FH: Migrate DB", "FH: ng serve"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            "label": "FH: Dev Stop",
            "dependsOn": ["FH: Free Ports", "FH: Infra Stop"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },

        // ═══ Tools (findhome CLI) ═══════════════════════════════════════════
        {
            "label": "FH: Config Validate",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/findhome config validate",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "FH: Scan site",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/findhome scan ${input:siteSlug}",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "FH: Scan site (dry run)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/findhome scan ${input:siteSlug} --dry-run --max-pages 1",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        {
            "label": "FH: History Digest",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/findhome digest history",
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": []
        },
        // Same API as "FH: Full Stack" but without the debugger, with auto-reload.
        // Useful when the debug session does not start: errors print in this terminal.
        {
            "label": "FH: API (no debugger)",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/findhome serve --reload",
            "options": { "cwd": "${workspaceFolder}/backend" },
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": {
                "owner": "fh-api",
                "pattern": { "regexp": "^$" },
                "background": { "activeOnStart": true, "beginsPattern": "Will watch|Started server process", "endsPattern": "Application startup complete|Application startup failed" }
            }
        },
        {
            "label": "FH: Pytest",
            "type": "shell",
            "command": "${workspaceFolder}/backend/.venv/bin/pytest -q",
            "options": { "cwd": "${workspaceFolder}/backend" },
            "problemMatcher": []
        },

        // ═══ Setup & checks ═════════════════════════════════════════════════
        {
            "label": "FH: Install",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/install.sh",
            "presentation": { "reveal": "always", "panel": "shared", "focus": true },
            "problemMatcher": []
        },
        {
            "label": "FH: Smoke Check",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/smoke-check.sh",
            "presentation": { "reveal": "always", "panel": "shared", "focus": true },
            "problemMatcher": []
        },
        {
            "label": "FH: Sync Skills",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/sync-skills.sh",
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "siteSlug",
            "type": "pickString",
            "description": "Site to scan (sites/<slug>)",
            "options": ["--all", "qasa", "blocket-bostad", "samtrygg", "bostadsformedlingen"],
            "default": "--all"
        }
    ]
}
