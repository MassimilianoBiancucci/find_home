// find_home — one app debug configuration.
// FH: Full Stack prepares the environment, restarts Compose, migrates the DB,
// starts Angular as a background task, then launches FastAPI under debugpy.
// Ending the debug session stops Angular and all Compose containers.
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "FH: Full Stack",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "findhome.api.main:app",
                "--host",
                "127.0.0.1",
                "--port",
                "8200",
                "--reload",
                "--reload-dir",
                "src"
            ],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "envFile": "${workspaceFolder}/config/backend.env",
            "env": {
                "FINDHOME_ROOT": "${workspaceFolder}"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "presentation": {
                "group": "find_home",
                "order": 1
            },
            "preLaunchTask": "FH: Dev Prereqs",
            "postDebugTask": "FH: Dev Stop"
        },
        {
            "name": "FH: CLI (prompt for args)",
            "type": "debugpy",
            "request": "launch",
            "module": "findhome.cli.main",
            "args": "${input:cliArgs}",
            "cwd": "${workspaceFolder}",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "envFile": "${workspaceFolder}/config/backend.env",
            "env": {
                "FINDHOME_ROOT": "${workspaceFolder}"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "presentation": {
                "group": "find_home",
                "order": 12
            }
        },
        {
            "name": "FH: Pytest",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": [
                "-q"
            ],
            "cwd": "${workspaceFolder}/backend",
            "python": "${workspaceFolder}/backend/.venv/bin/python",
            "env": {
                "FINDHOME_ROOT": "${workspaceFolder}"
            },
            "justMyCode": false,
            "console": "integratedTerminal",
            "presentation": {
                "group": "find_home",
                "order": 12
            }
        }
    ],
    "inputs": [
        {
            "id": "cliArgs",
            "type": "promptString",
            "description": "findhome CLI arguments, e.g. 'digest history' or 'scan qasa --dry-run'",
            "default": "digest history"
        }
    ]
}
