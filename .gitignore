# Personal data and secrets stay local; only dummy *.example.* / *.env.example templates are committed.
# Rule and checklist: guide/principles/personal_data.md. scripts/ensure-env.sh creates the real files from the examples.
.env
.env.*
!.env.example
*.env
!*.env.example
*.env.local
config/locations.yaml
config/profile.yaml
config/search_area.yaml

# Python
backend/.venv/
**/__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.angular/

# Runtime data (Postgres files, local backups, caches, raw snapshots, exports)
data/
# Agent run folders (scratchpads, logs, state); keep the README
runs/*
!runs/README.md
# File inbox for agents without API access; keep the README
inbox/*
!inbox/README.md

# Site probe raw dumps (reports are committed)
sites/*/probe/raw/

# OS / editors
.DS_Store
Thumbs.db

# Task scratch backups
tasks/**/scripts/.*.md

tasks/*
