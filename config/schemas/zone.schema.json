{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findhome.local/schemas/zone.schema.json",
  "title": "Zone analysis",
  "type": "object",
  "properties": {
    "speeds_mps": {
      "type": "object",
      "properties": {
        "walk": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "bike": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "walk",
        "bike"
      ],
      "additionalProperties": false
    },
    "factors": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "exclusiveMinimum": 0
      }
    },
    "cutoff_min": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 60
    },
    "bins_min": {
      "type": "array",
      "items": {
        "type": "number",
        "exclusiveMinimum": 0
      },
      "minItems": 2
    },
    "snap_max_m": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "target_sets": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string"
          },
          "stops": {
            "type": "array",
            "items": {
              "enum": [
                "metro",
                "commuter_rail",
                "local_rail",
                "tram",
                "train",
                "bus",
                "ferry"
              ]
            }
          },
          "poi": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "label"
        ],
        "anyOf": [
          {
            "required": [
              "stops"
            ]
          },
          {
            "required": [
              "poi"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "homes": {
      "type": "object",
      "properties": {
        "buildings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_levels": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        }
      },
      "additionalProperties": false
    },
    "indices": {
      "type": "object",
      "properties": {
        "access_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "windows": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "hours": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 24
                },
                "minItems": 2,
                "maxItems": 2
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "hours",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "components": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "rail_access",
              "bus_access",
              "coverage",
              "lines",
              "frequency"
            ]
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "zero": {
                "type": "number"
              },
              "full": {
                "type": "number"
              },
              "weight": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "zero",
              "full",
              "weight"
            ],
            "additionalProperties": false
          }
        },
        "services": {
          "type": "object",
          "properties": {
            "sets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "zero": {
              "type": "number"
            },
            "full": {
              "type": "number"
            },
            "choice": {
              "type": "object",
              "description": "count of targets within within_min walk, scored 0 → full; mixed with proximity by weight",
              "properties": {
                "within_min": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "full": {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                "weight": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "sets",
            "zero",
            "full"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "access_min",
        "windows",
        "components",
        "services"
      ],
      "additionalProperties": false
    },
    "combined": {
      "type": "object",
      "description": "combined score: weighted mean of index parts (0-100)",
      "properties": {
        "parts": {
          "type": "object",
          "propertyNames": {
            "enum": [
              "transport",
              "services"
            ]
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "parts"
      ],
      "additionalProperties": false
    },
    "density": {
      "type": "object",
      "description": "POI density per zone",
      "properties": {
        "per_homes": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "additionalProperties": false
    },
    "house": {
      "type": "object",
      "description": "house analysis from the exact address",
      "properties": {
        "cutoff_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "sets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services_depart": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "reach": {
          "type": "object",
          "description": "the home's transport score: share of the minutes to your points, and their good / bad limits",
          "properties": {
            "weight": {"type": "number", "minimum": 0, "maximum": 1},
            "good_min": {"type": "number", "minimum": 0},
            "bad_min": {"type": "number", "exclusiveMinimum": 0}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "walk_colours": {
      "type": "object",
      "description": "walking minutes: green up to, yellow up to; above is red",
      "properties": {
        "green": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "yellow": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "green",
        "yellow"
      ],
      "additionalProperties": false
    },
    "centroids": {
      "type": "object",
      "properties": {
        "walk_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_walk_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "coverage": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "min_gain": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "groups": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "enum": [
                "metro",
                "commuter_rail",
                "local_rail",
                "tram",
                "train",
                "bus",
                "ferry"
              ]
            }
          }
        },
        "reference": {
          "type": "boolean"
        },
        "range_m": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "strategy": {
          "enum": [
            "stops",
            "homes"
          ]
        }
      },
      "required": [
        "walk_min",
        "max_walk_min",
        "coverage",
        "min_gain",
        "groups"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "speeds_mps",
    "cutoff_min",
    "bins_min",
    "target_sets"
  ],
  "additionalProperties": false
}
