{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findhome.local/schemas/site.schema.json",
  "title": "Listing site registry entry",
  "type": "object",
  "properties": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "name": {
      "type": "string"
    },
    "url": {
      "type": "string"
    },
    "kinds": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "rent",
          "buy"
        ]
      },
      "minItems": 1
    },
    "status": {
      "enum": [
        "unverified",
        "active",
        "broken",
        "disabled"
      ]
    },
    "role": {
      "enum": [
        "scanned",
        "origin"
      ],
      "default": "scanned",
      "description": "scanned: listings are collected from this site. origin: never scanned; the site only identifies where listings found on an aggregator were first published (see the aggregator's `platforms`)."
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logo": {
          "type": [
            "string",
            "null"
          ],
          "description": "File in this site folder (logo.svg/png), served at /api/sites/<slug>/logo; the favicon is the fallback"
        },
        "colour": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "favicon": {
          "type": [
            "string",
            "null"
          ],
          "description": "Icon URL used when no logo file exists (default: https://<host of url>/favicon.ico)"
        }
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "description": "What may scan this site: a scripted scanner (api/http/playwright) and/or the browser agent in the user's own browser",
      "properties": {
        "script": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why the method is off (shown in the UI and in scan errors)"
            }
          }
        },
        "browser": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "reason": {
              "type": [
                "string",
                "null"
              ],
              "description": "Why the method is off (shown in the UI and in scan errors)"
            },
            "extractor": {
              "type": [
                "string",
                "null"
              ],
              "description": "JS file in the site folder run on each loaded result page"
            },
            "default_pages": {
              "type": "integer",
              "minimum": 1
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            },
            "inputs": {
              "type": "array",
              "description": "Search inputs on the result page the agent sets before extracting; the app computes the values to try (runs/state/<site>.json input_sets)",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "filter",
                  "label"
                ],
                "properties": {
                  "filter": {
                    "enum": [
                      "move_in_from"
                    ],
                    "description": "Profile filter the values come from (move_in_from: one date per month of move_in_from..move_in_to)"
                  },
                  "label": {
                    "type": "string",
                    "description": "The field's visible label"
                  },
                  "selector": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "CSS selector of the field"
                  },
                  "how": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "How to set it in the browser (clicks, date picker)"
                  }
                }
              }
            },
            "next_page": {
              "type": "object",
              "additionalProperties": false,
              "description": "Result pages reached in the page itself (a next-page control after the inputs are set) instead of one URL per page",
              "properties": {
                "label": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "selector": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "how": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "platforms": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Aggregators only: value of the listing's attributes.platform → slug of the site it was first published on"
    },
    "risk_note": {
      "type": [
        "string",
        "null"
      ],
      "description": "A recorded decision to scan despite robots.txt or terms (who, when, limits)"
    },
    "local_filter": {
      "type": "object",
      "description": "Scanner-specific local filters applied before ingest (e.g. type flags to exclude)"
    },
    "last_verified": {
      "type": [
        "string",
        "null"
      ]
    },
    "fetch": {
      "type": "object",
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "enum": [
              "api",
              "http",
              "playwright",
              "agent_browser"
            ]
          }
        },
        "method": {
          "enum": [
            "api",
            "http",
            "playwright",
            "agent_browser",
            null
          ]
        },
        "list_url_template": {
          "type": [
            "string",
            "null"
          ]
        },
        "api": {
          "type": "object",
          "properties": {
            "endpoint": {
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "enum": [
                "GET",
                "POST"
              ]
            },
            "items_path": {
              "type": [
                "string",
                "null"
              ]
            },
            "body": {
              "type": [
                "object",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "selectors": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "pagination": {
          "type": "object",
          "properties": {
            "type": {
              "enum": [
                "page_param",
                "offset_param",
                "cursor",
                "none"
              ]
            },
            "param": {
              "type": [
                "string",
                "null"
              ]
            },
            "max_pages": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        },
        "details": {
          "type": "object",
          "additionalProperties": false,
          "description": "Optional detail-page enrichment for NEW listings (needs a site scanner.py with enrich())",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_per_run": {
              "type": "integer",
              "minimum": 0,
              "maximum": 200
            }
          }
        },
        "fixed_params": {
          "type": "object",
          "description": "Query parameters always sent (e.g. the search area)",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "boolean"
            ]
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "order",
        "method"
      ]
    },
    "filter_map": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "param": {
            "type": [
              "string",
              "null"
            ]
          },
          "ui_step": {
            "type": [
              "string",
              "null"
            ]
          },
          "local_only": {
            "type": "boolean"
          },
          "value_map": {
            "type": "object"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "field_map": {
      "type": "object"
    },
    "pets": {
      "type": "object",
      "properties": {
        "filter_available": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "typical_wording": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "none",
            "browser_session"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "mode"
      ]
    },
    "politeness": {
      "type": "object",
      "properties": {
        "min_delay_s": {
          "type": "number",
          "minimum": 0
        },
        "max_pages_per_run": {
          "type": "integer",
          "minimum": 1
        },
        "respect_robots": {
          "type": "boolean"
        },
        "user_agent": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "min_delay_s",
        "max_pages_per_run",
        "respect_robots"
      ]
    },
    "schedule": {
      "type": "object",
      "properties": {
        "interval": {
          "type": [
            "string",
            "null"
          ],
          "description": "e.g. 6h, 1d — read by an external scheduler"
        }
      },
      "additionalProperties": false
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false,
  "required": [
    "slug",
    "name",
    "url",
    "kinds",
    "status",
    "fetch",
    "filter_map",
    "auth",
    "politeness"
  ]
}
