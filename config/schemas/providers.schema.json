{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findhome.local/schemas/providers.schema.json",
  "title": "External providers",
  "type": "object",
  "properties": {
    "routing": {
      "type": "object",
      "properties": {
        "haversine": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": true
        },
        "osm": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": true
        },
        "resrobot": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": true
        },
        "google": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": true
        },
        "ors": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          },
          "required": [
            "enabled"
          ],
          "additionalProperties": true
        }
      },
      "additionalProperties": false,
      "required": [
        "haversine"
      ]
    },
    "mode_priority": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "geocoding": {
      "type": "object"
    },
    "poi": {
      "type": "object"
    },
    "budget": {
      "type": "object",
      "properties": {
        "max_routing_calls_per_run": {
          "type": "integer",
          "minimum": 0
        },
        "max_connectivity_calls_per_run": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "connectivity": {
      "type": "object",
      "description": "Map → Connectivity refresh: what to do when the transit provider keeps failing, and the call cap per run.",
      "properties": {
        "on_provider_failure": {
          "enum": [
            "ask",
            "continue",
            "estimate"
          ],
          "description": "ask: pause and ask in the UI; continue: keep calling; estimate: straight-line estimates for the rest of the run"
        },
        "max_calls_per_run": {
          "type": "integer",
          "minimum": 0
        },
        "origin": {
          "enum": [
            "stations",
            "zone"
          ],
          "description": "stations: route from each zone's connectivity centroids (findhome zone centroids); zone: from one point inside each zone"
        }
      },
      "additionalProperties": false
    },
    "cache": {
      "type": "object",
      "properties": {
        "routing_ttl_days": {
          "type": "integer"
        },
        "geocode_ttl_days": {
          "type": "integer"
        },
        "poi_ttl_days": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "prefilter": {
      "type": "object",
      "properties": {
        "max_haversine_km_by_category": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        }
      },
      "additionalProperties": false
    },
    "map": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "maplibre",
            "google"
          ]
        },
        "style_url": {
          "type": "string"
        },
        "style_url_dark": {
          "type": "string"
        },
        "attribution": {
          "type": "string"
        },
        "center": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "zoom": {
          "type": "number"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "required": [
    "routing",
    "mode_priority",
    "budget",
    "cache",
    "map"
  ]
}
