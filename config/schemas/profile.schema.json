{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://findhome.local/schemas/profile.schema.json",
  "title": "Search profile per listing kind",
  "type": "object",
  "properties": {
    "kinds": {
      "type": "object",
      "properties": {
        "rent": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hard_filters": {
              "type": "object",
              "properties": {
                "max_rent_sek": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "min_size_m2": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "min_rooms_rok": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "accept_sovalkov": {
                  "type": "boolean"
                },
                "move_in_from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "move_in_to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "areas_include": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "areas_exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "contract_types": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "first_hand",
                      "second_hand",
                      "sublet"
                    ]
                  }
                },
                "pet_status_exclude": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no",
                      "ask",
                      "unknown"
                    ]
                  }
                },
                "max_commute_min_by_category": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "max_price_sek": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "max_avgift_sek": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "description": "Gate filters; keys must exist in filters_catalog.yaml"
            },
            "preferences": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Relative weight of this group in the total score"
                  },
                  "params": {
                    "type": "object",
                    "description": "Group-specific parameters (see guide/architecture)"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "enabled",
                  "weight"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "hard_filters",
            "preferences"
          ]
        },
        "buy": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "hard_filters": {
              "type": "object",
              "properties": {
                "max_rent_sek": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "min_size_m2": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "min_rooms_rok": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0
                },
                "accept_sovalkov": {
                  "type": "boolean"
                },
                "move_in_from": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "move_in_to": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "areas_include": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "areas_exclude": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "contract_types": {
                  "type": "array",
                  "items": {
                    "enum": [
                      "first_hand",
                      "second_hand",
                      "sublet"
                    ]
                  }
                },
                "pet_status_exclude": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "yes",
                      "no",
                      "ask",
                      "unknown"
                    ]
                  }
                },
                "max_commute_min_by_category": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "max_price_sek": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                },
                "max_avgift_sek": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "description": "Gate filters; keys must exist in filters_catalog.yaml"
            },
            "preferences": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "enabled": {
                    "type": "boolean"
                  },
                  "weight": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 10,
                    "description": "Relative weight of this group in the total score"
                  },
                  "params": {
                    "type": "object",
                    "description": "Group-specific parameters (see guide/architecture)"
                  }
                },
                "additionalProperties": false,
                "required": [
                  "enabled",
                  "weight"
                ]
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "enabled",
            "hard_filters",
            "preferences"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "rent"
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "kinds"
  ]
}
