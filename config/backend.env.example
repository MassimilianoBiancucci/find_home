# find_home backend settings: EXAMPLE, committed.
# The real file is config/backend.env (gitignored). scripts/ensure-env.sh copies this template there when it is
# missing and never overwrites it. Loaded by .vscode/launch.json (envFile) and by the findhome CLI.
# Rule: guide/principles/personal_data.md.

# Local development database from docker-compose.yml. postgres/postgres is a localhost-only default (the port is
# bound to this machine), not a secret. Change it here AND in docker-compose.yml if you expose Postgres elsewhere.
FINDHOME_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/findhome
FINDHOME_API_HOST=127.0.0.1
FINDHOME_API_PORT=8200
FINDHOME_LOG_LEVEL=INFO
