# find_home backend settings (dotenv, loaded by launch.json envFile and by the CLI).
# Copy to backend.env (gitignored) — scripts/install.sh does it for you.
FINDHOME_DATABASE_URL=postgresql://postgres:postgres@localhost:5434/findhome
FINDHOME_API_HOST=127.0.0.1
FINDHOME_API_PORT=8200
FINDHOME_LOG_LEVEL=INFO
