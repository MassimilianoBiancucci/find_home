# Provider keys (dotenv). Copy to providers.env (gitignored). All optional.
# Trafiklab ResRobot v2.1 (transit) — see docs/providers.md
TRAFIKLAB_RESROBOT_KEY=
# Trafiklab GTFS Regional Static (SL lines and stations for the map; OSM routes are used without it)
TRAFIKLAB_GTFS_KEY=
# OpenRouteService (address suggestions, walking minutes) — see docs/providers.md
ORS_API_KEY=
# Google Maps Platform (off by default) — see docs/google-apis.md
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=
# Nominatim usage policy asks for a contact email in requests
NOMINATIM_EMAIL=
