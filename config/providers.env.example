# find_home provider keys: EXAMPLE, committed. Every value is empty on purpose.
# The real file is config/providers.env (gitignored: it holds your secrets). scripts/ensure-env.sh copies this
# template there when it is missing and never overwrites it. All keys are optional: without one, the matching
# feature falls back to a free or estimated answer (see docs/providers.md).
# Rule: guide/principles/personal_data.md. Never paste a real key into this file.

# Trafiklab ResRobot v2.1: public transport itineraries and commute times (without it: straight-line estimates).
# trafiklab.se → create a project → add "ResRobot v2.1".
TRAFIKLAB_RESROBOT_KEY=

# Trafiklab GTFS Regional Static: SL lines and stations for the map (without it: OpenStreetMap routes).
# Same Trafiklab project → add "GTFS Regional Static data".
TRAFIKLAB_GTFS_KEY=

# OpenRouteService: walking minutes and address suggestions (without it: straight-line estimates, Photon suggestions).
# openrouteservice.org → sign up → dashboard → request a token.
ORS_API_KEY=

# Google Maps Platform: off by default, see docs/google-apis.md for costs.
GOOGLE_MAPS_SERVER_KEY=
GOOGLE_MAPS_BROWSER_KEY=

# The Nominatim usage policy asks for a contact email in requests. Your own address; it stays on your machine.
NOMINATIM_EMAIL=
